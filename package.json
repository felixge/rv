{
  "name": "rv",
  "version": "0.1.0",
  "description": "A small local code review tool. Select lines, leave comments, copy a prompt.",
  "type": "module",
  "bin": {
    "rv": "bin/rv.js"
  },
  "files": [
    "bin",
    "server",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "node bin/rv.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser.js",
    "test:performance": "node test/startup.js && node test/navigation.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@pierre/diffs": "1.4.3",
    "@pierre/trees": "1.0.0-beta.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
